  "text_041": {
    "type": "text",
    "label": "Kage begins where the city stops: a mountain gate of cedar burned blac",
    "section": "Gerbang",
    "default": "Kage begins where the city stops: a mountain gate of cedar burned black,\n        standing in its own weather. The soot is not decoration. It is how a board is taught to survive a\n        hundred rainy seasons, and the first thing this place asks you to understand.",
    "offset": 58699,
    "length": 264,
    "source": "Kage begins where the city stops: a mountain gate of cedar burned black,\n        standing in its own weather. The soot is not decoration. It is how a board is taught to survive a\n        hundred rainy seasons, and the first thing this place asks you to understand.",
