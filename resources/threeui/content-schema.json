  },
  "text_042": {
    "type": "text",
    "label": "Climb the worn steps and the worship hall lifts out of the mist, its p",
    "section": "Gerbang",
    "default": "Climb the worn steps and the worship hall lifts out of the mist, its paper\n        screens lit from inside like a lantern the size of a house. Above the eaves a vermilion moon holds\n        its place, patient, half hidden. Nothing here is in a hurry. Neither, for the next ninety minutes,\n        are you.",
    "offset": 59003,
    "length": 305,
    "source": "Climb the worn steps and the worship hall lifts out of the mist, its paper\n        screens lit from inside like a lantern the size of a house. Above the eaves a vermilion moon holds\n        its place, patient, half hidden. Nothing here is in a hurry. Neither, for the next ninety minutes,\n        are you.",
